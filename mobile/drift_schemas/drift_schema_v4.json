        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"raw_message_id\" INTEGER NULL REFERENCES raw_messages (id), \"amount_paise\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'INR', \"direction\" TEXT NOT NULL, \"channel\" TEXT NULL, \"merchant\" TEXT NULL, \"account_id\" INTEGER NULL REFERENCES accounts (id), \"category_id\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'confirmed', \"reference\" TEXT NULL, \"note\" TEXT NULL, \"bank_code\" TEXT NULL, \"last4\" TEXT NULL, \"account_kind\" TEXT NULL, \"category_name\" TEXT NULL, \"confirm_reason\" TEXT NULL, \"user_corrected\" INTEGER NOT NULL DEFAULT 0 CHECK (\"user_corrected\" IN (0, 1)), \"fingerprint\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"shared\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shared\" IN (0, 1)), \"self_transfer\" INTEGER NOT NULL DEFAULT 0 CHECK (\"self_transfer\" IN (0, 1)), \"model_id\" TEXT NULL, \"prompt_version\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
